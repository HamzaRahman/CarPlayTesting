<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1: Claim source (onRequestPlayAudio)"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RADIO" />

            <Button
                android:id="@+id/btnUsb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="USB" />

            <Button
                android:id="@+id/btnBt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BT" />

            <Button
                android:id="@+id/btnAux"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AUX" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2: Publish fake MediaSession (title/timestamp)"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fake track / file name"
            android:text="TEST_TRACK_01.mp3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start fake session" />

            <Button
                android:id="@+id/btnStopSession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop session" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position/duration auto-increments once the session is started, simulating audio timestamp updates every second."
            android:textSize="12sp"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 3 (optional): Raw steering-wheel key inject via McuManager"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKeyBt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="K_BT (302)" />

            <Button
                android:id="@+id/btnKeyBtMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="K_BTMUSIC (331)" />

            <Button
                android:id="@+id/btnKeyMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="K_MUSIC (209)" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFuelInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fuel &amp; Doors reference (from CarInfo.apk)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 4: Listen to what's sent to CAN while music plays"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <Button
            android:id="@+id/btnMusicListener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start MusicInfo listener" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 5: USB emulation + auto BT position bridge"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#332A1B"
            android:padding="8dp"
            android:text="USB button plays a real silent local MediaPlayer loop under our own claimed source -- this is what Step 4 confirmed actually gets reported. The bridge below auto-detects BT playback and syncs the loop's position to match it. Bridge needs one-time Notification access (opens Settings automatically)."
            android:textColor="#F5C36B"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnBtBridge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start BT→USB bridge (auto)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log:"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp"
            android:background="#111111"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="8dp"
            android:text="Ready.\n" />

    </LinearLayout>
</ScrollView>
